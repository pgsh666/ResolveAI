APP_NAME=ResolveAI
APP_ENV=development
AUTH_ENABLED=true
AUTH_COOKIE_SECURE=false
PUBLIC_DEPLOYMENT=false
# Native backend also loads the project-root private .env.auth (generated by bootstrap-auth.ps1).
AGENT_MODE=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_FAST_MODEL=gpt-5-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_FAST_MODEL=deepseek-flash
NONCRITICAL_MODEL_STAGES=triage,rewrite
MODEL_TIMEOUT_SECONDS=20
MODEL_MAX_RETRIES=2
TOOL_TIMEOUT_SECONDS=5
TOOL_MAX_RETRIES=2
RETRY_BACKOFF_SECONDS=0.2
RAG_MIN_SCORE=0.15
QUALITY_MAX_REGENERATIONS=1
FAILURE_ESCALATION_THRESHOLD=2
EMBEDDING_DIMENSIONS=256
EMBEDDING_PROVIDER=fastembed
SEMANTIC_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
SEMANTIC_RAG_MIN_SCORE=0.55
PROMPT_VERSION=resolveai-prompts-2026-10-12-v3
MODEL_INPUT_COST_PER_MILLION_USD=0
MODEL_OUTPUT_COST_PER_MILLION_USD=0
FAST_MODEL_INPUT_COST_PER_MILLION_USD=0
FAST_MODEL_OUTPUT_COST_PER_MILLION_USD=0
MODEL_PRIMARY_MAX_OUTPUT_TOKENS=1600
MODEL_FAST_MAX_OUTPUT_TOKENS=600
MODEL_MAX_CONTEXT_CHARS=12000
AGENT_MAX_CONVERSATION_MESSAGES=8
AGENT_MAX_MESSAGE_CHARS=1200
RAG_MAX_DOCUMENTS=3
RAG_SNIPPET_CHARS=240
RETRIEVAL_CACHE_ENABLED=true
RETRIEVAL_CACHE_TTL_SECONDS=300
PERFORMANCE_SAMPLE_WINDOW=1000
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=240
MAX_CONCURRENT_REQUESTS=32
REQUEST_QUEUE_TIMEOUT_SECONDS=2
OTEL_ENABLED=false
OTEL_SERVICE_NAME=resolveai-backend
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
OTEL_EXPORT_TIMEOUT_SECONDS=5
OTEL_SAMPLE_RATIO=1
OTEL_CONSOLE_EXPORTER=false
OTEL_UI_URL=http://localhost:16686
ASYNC_TASKS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
TASK_QUEUE_NAME=resolveai
TASK_DEFAULT_TIMEOUT_SECONDS=900
TASK_EVALUATION_TIMEOUT_SECONDS=1800
TASK_RESULT_TTL_SECONDS=86400
TASK_FAILURE_TTL_SECONDS=86400
TASK_EVALUATION_OUTPUT_DIR=./evaluation/reports/tasks
DATABASE_URL=sqlite:///./resolveai.db
CORS_ORIGINS=http://localhost:3000
MCP_ENABLED=false
MCP_SERVER_URL=http://127.0.0.1:8001/mcp
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8001
TOOL_APPROVAL_SECRET=replace-with-at-least-24-random-characters
